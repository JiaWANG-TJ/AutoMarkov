# profile.json 的 build_context_files 与域分离哈希冻结全部构建输入；实际 OCI digest 仅在镜像构建并验证后登记。
FROM --platform=linux/amd64 python:3.11.13-slim-bookworm@sha256:cec9aa7aa96eea4fa036e9b82be1e6b325f2e3707f462d885868df51ec0a4b47
COPY --from=ghcr.io/astral-sh/uv:0.11.16@sha256:440fd6477af86a2f1b38080c539f1672cd22acb1b1a47e321dba5158ab08864d /uv /uvx /bin/
ENV PYTHONDONTWRITEBYTECODE=1
WORKDIR /opt/automarkov-profile
COPY pyproject.toml uv.lock ./
RUN --mount=type=bind,source=taxi_deny.py,target=/tmp/taxi_deny.py,ro \
    UV_CACHE_DIR=/tmp/uv-cache uv sync --frozen --no-dev --no-install-project \
    && .venv/bin/python /tmp/taxi_deny.py harden --cache-root /tmp/uv-cache \
    && .venv/bin/python /tmp/taxi_deny.py verify --cache-root /tmp/uv-cache
