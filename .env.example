# 本地或远程节点内的 vLLM endpoint；AutoMarkov 不回退到 API LLM。
AUTOMARKOV_VLLM_BASE_URL=http://127.0.0.1:8000/v1
AUTOMARKOV_VLLM_MODEL=Qwen/Qwen3.6-35B-A3B
AUTOMARKOV_VLLM_TIMEOUT_SECONDS=180
# 仅填写 owner-only 0600 regular credential file 路径，不在环境变量中填写 token。
AUTOMARKOV_VLLM_API_KEY_FILE=secrets/vllm_api_key

# 本地 embedding 模型；revision 必须写入复现清单。
AUTOMARKOV_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Tavily 凭据按编号读取，真实值不得提交。
TAVILY_API_KEY_01=
TAVILY_API_KEY_02=
TAVILY_API_KEY_03=
TAVILY_API_KEY_04=
TAVILY_API_KEY_05=
TAVILY_API_KEY_06=
TAVILY_API_KEY_07=
TAVILY_API_KEY_08=
TAVILY_API_KEY_09=
TAVILY_API_KEY_10=
TAVILY_API_KEY_11=
TAVILY_API_KEY_12=
TAVILY_API_KEY_13=
TAVILY_API_KEY_14=
TAVILY_API_KEY_15=
TAVILY_API_KEY_16=
TAVILY_API_KEY_17=
TAVILY_API_KEY_18=
TAVILY_API_KEY_19=
TAVILY_API_KEY_20=
TAVILY_API_KEY_21=
TAVILY_API_KEY_22=
TAVILY_API_KEY_23=
TAVILY_API_KEY_24=
TAVILY_API_KEY_25=
TAVILY_API_KEY_26=
TAVILY_API_KEY_27=
TAVILY_API_KEY_28=
TAVILY_API_KEY_29=

# 实验追踪默认离线。
SWANLAB_MODE=offline
